radius     = 6;       //starting size
max_radius = 80;      //how far out it spreads
spread     = 0.15;    //how fast it spreads (bigger = faster)
thickness  = 3;       //how thick the ring line is
squash     = 0.4;     //how flat the ring is (1 = circle, 0.4 = lying on the ground)
colour     = c_aqua;  //the player sets this when he creates it
